Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.6
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: LivoxRaw
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /livox/lidar
      Color Transformer: AxisColor
      Decay Time: 3
      Position Transformer: XYZ
      Size (Pixels): 2
      Size (m): 0.02
      Style: Flat Squares
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: CloudRegistered
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /cloud_registered
      Color Transformer: AxisColor
      Decay Time: 15
      Position Transformer: XYZ
      Size (Pixels): 3
      Size (m): 0.02
      Style: Flat Squares
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: LaserMap
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /Laser_map
      Color Transformer: AxisColor
      Decay Time: 0
      Position Transformer: XYZ
      Size (Pixels): 3
      Size (m): 0.03
      Style: Flat Squares
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: PointLioOdometry
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /aft_mapped_to_init
      Keep: 100
      Shape:
        Value: Arrow
        Axes Length: 0.6
        Axes Radius: 0.05
        Color: 255; 80; 40
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: PointLioPath
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /path
      Color: 40; 255; 80
      Line Width: 0.03
      Value: true
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: DogGlobalPose
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /dog/global_pose
      Shape:
        Value: Arrow
        Color: 60; 255; 70
      Value: true
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: CurrentNavGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /behavior/nav_goal
      Shape:
        Value: Arrow
        Color: 40; 120; 255
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: TestRoute
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /behavior/test_visualization/route
      Color: 40; 230; 230
      Line Width: 0.05
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: TestNavigationMarkers
      Marker Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /behavior/test_visualization/markers
      Namespaces:
        {}
      Value: true
  Enabled: true
  Global Options:
    Background Color: 15; 15; 15
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 1.5
        Y: 1.5
        Z: 0
      Name: Current View
      Pitch: 0.9
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
